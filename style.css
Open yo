scroll-behavior: smooth;
}

body {
  background: #080808;
  color: #f5f5f5;
  font-family: Arial, sans-serif;
}

.portfolio {
  max-width: 1100px;
  margin: auto;
  padding: 30px;
}

nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #292929;
  padding-bottom: 25px;
}

nav h2 {
  letter-spacing: 3px;
}

nav h2 span {
  color: #d4af37;
}

nav p, .tag {
  color: #d4af37;
  font-size: 11px;
  letter-spacing: 2px;
}

.hero {
  padding: 120px 0;
  max-width: 750px;
}

.hero h1 {
  font-size: clamp(42px, 8vw, 76px);
  line-height: 1.1;
  margin: 25px 0;
}

.intro, #about p {
  color: #aaa;
  line-height: 1.8;
  max-width: 550px;
}

.button {
  display: inline-block;
  margin-top: 30px;
  padding: 15px 22px;
  border: 1px solid #d4af37;
  color: #d4af37;
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 1px;
}

.button:hover {
  background: #d4af37;
  color: #080808;
}

section:not(.hero) {
  padding: 55px 0;
  border-top: 1px solid #292929;
}

section h2 {
  color: #d4af37;
  font-size: 18px;
  letter-spacing: 2px;
  margin-bottom: 25px;
}

.skills p {
  padding: 16px 0;
  border-bottom: 1px solid #292929;
  color: #ccc;
}

footer {
  border-top: 1px solid #292929;
  padding: 25px 0;
  color: #777;
  font-size: 11px;
  letter-spacing: 2px;
}

@media (max-width: 600px) {
  .portfolio {
    padding: 20px;
  }

  nav p {
    font-size: 8px;
  }

  .hero {
    padding: 85px 0;
  }
}